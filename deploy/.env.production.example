# Docker Compose와 API가 함께 읽는 운영 설정입니다.
# 이 파일을 .env.production으로 복사한 뒤 VM에서만 실제 값을 채우세요.
POSTGRES_DB=nature_go
POSTGRES_USER=nature_go
POSTGRES_PASSWORD=replace-with-a-long-random-password

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
BIOCLIP_ENDPOINT=http://127.0.0.1:8931
BIOCLIP_TIMEOUT_MS=15000
PROFESSOR_EMBEDDING_ENDPOINT=http://127.0.0.1:8941
PROFESSOR_EMBEDDING_TIMEOUT_MS=3000
AUDIO_MODEL_SERVICE_URL=http://127.0.0.1:8932
AUDIO_MODEL_SERVICE_TOKEN=
AUDIO_MODEL_NAME=birdnet
AUDIO_MODEL_TIMEOUT_MS=15000
AUDIO_REFERENCE_SET_VERSION=kr-bird-reference@2026-07

KAKAO_MAP_JS_KEY=
FREE_DAILY_IDENTIFY_LIMIT=20

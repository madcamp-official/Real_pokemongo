# =============================================================================
# 『씨앗(SEED)』 환경 변수 예시
# -----------------------------------------------------------------------------
# 사용법: 이 파일을 `.env` 로 복사한 뒤, 아래 공란(빈 값)을 실제 값으로 채운다.
# 값이 비어 있으면 서비스는 안전한 개발용 기본값(Mock 동정, in-memory 저장소)으로
# 동작한다. 프로덕션 전에 반드시 채워야 하는 항목은 [필수-프로덕션] 으로 표시.
# =============================================================================

# --- 실행 환경 -----------------------------------------------------------------
NODE_ENV=development

# --- 데이터베이스 [필수-프로덕션] ------------------------------------------------
# PostgreSQL 14 — BioCLIP과 같은 GPU 서버에 설치했다. 127.0.0.1에만 바인딩되어 있고
# 외부 방화벽을 열지 않았으므로, BIOCLIP_ENDPOINT와 동일하게 SSH 로컬 포트포워딩으로
# 터널을 먼저 열어야 한다(터미널에서, 개발자 본인 키로):
#   ssh -L 5433:127.0.0.1:5432 <user>@<gpu-server-host>
# 비워두면(기본) InMemory 저장소로 동작한다(서버 재시작 시 데이터 소실, 개발/테스트 기본값).
# DATABASE_URL=postgres://seed_app:<비밀번호>@127.0.0.1:5433/seed_service
DATABASE_URL=

# --- 미디어 저장소 [필수-프로덕션] ------------------------------------------------
# TODO(제공 필요): 사진 업로드용 오브젝트 스토리지 (S3 등) 자격 증명/버킷
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
# C단계 MVP: 위 클라우드 설정이 비어있는 동안은 로컬 디스크에 저장한다(과금 없음).
MEDIA_STORAGE_LOCAL_DIR=./data/media

# --- 동정(Identification) 외부 API ---------------------------------------------
# 어느 것도 채우지 않으면 MockProvider 로 동작한다(개발/데모용).
# Plant.id (kindwise) — 식물 + insect.id(곤충)
# TODO(제공 필요): 유료 API 키
PLANT_ID_API_KEY=
PLANT_ID_ENDPOINT=https://plant.id/api/v3
INSECT_ID_ENDPOINT=https://insect.kindwise.com/api/v1

# Pl@ntNet — 식물 (대체/보조 프로바이더)
# TODO(제공 필요): 유료 API 키
PLANTNET_API_KEY=
PLANTNET_ENDPOINT=https://my-api.plantnet.org/v2

# BioCLIP 하이브리드 추론 서버(B단계) — 자체 GPU 서버, systemd 상시 구동.
# 이 서버는 127.0.0.1에만 바인딩되어 있고 외부 방화벽을 열지 않았으므로, 로컬 개발 중에는
# SSH 로컬 포트포워딩으로 터널을 먼저 열어야 한다(터미널에서, 개발자 본인 키로):
#   ssh -L 8931:127.0.0.1:8931 <user>@<gpu-server-host>
# apiKey가 없는 프로바이더라 endpoint 자체가 온/오프 스위치다 -- 비워두면(기본) 꺼진
# 상태로 동작한다(Mock으로 폴백). 터널을 띄운 뒤에만 아래 주석을 풀고 값을 채운다.
# BIOCLIP_ENDPOINT=http://127.0.0.1:8931
BIOCLIP_TIMEOUT_MS=15000

# --- 소리 동정(Audio, docs/audio/API_CONTRACT.md) -------------------------------
# audio-model-service(BirdNET 기반) — BioCLIP과 같은 GPU 서버(CAMP-3=172.10.5.71)에
# 별도 프로세스로 띄운다(systemd, 127.0.0.1:8932 전용 바인딩, 외부 비공개). 로컬 개발
# 중에는 BioCLIP과 동시에 터널을 열어야 한다(터미널에서, 개발자 본인 키로):
#   ssh -L 8932:127.0.0.1:8932 <user>@<gpu-server-host>
# 값이 없으면(기본) 이 프로바이더는 꺼진 상태로 동작한다(BioCLIP과 동일한 온/오프 관례).
# AUDIO_MODEL_SERVICE_URL=http://127.0.0.1:8932
AUDIO_MODEL_TIMEOUT_MS=15000
# TODO(제공 필요): 모델 서비스 내부 인증 토큰(같은 서버 안에서만 통하는 값이라 저위험이지만,
#                  실제 값은 여기 채우지 말고 배포 시 서버에서만 별도 관리)
AUDIO_MODEL_SERVICE_TOKEN=
# 9단계: audio_identification_result.model_provider 등에 쓰는 프로바이더 이름(비밀값 아님).
AUDIO_MODEL_NAME=birdnet
# 9단계: 기대하는 모델 버전(운영 모니터링 전용, GET /audio/health가 실제 응답 버전과
# 비교해 알려준다) — 실제 동정/유사도 계산은 항상 모델이 그 순간 응답한 버전을 쓴다.
# 안 채우면(기본) 버전 비교를 생략한다.
AUDIO_MODEL_VERSION=
# 9단계: species_sound_reference 적재 시 쓰는 참조 세트 버전(비밀값 아님) — 적재 스크립트가
# clips.csv의 임시값을 무시하고 이 값으로 덮어쓴다.
AUDIO_REFERENCE_SET_VERSION=kr-bird-reference@2026-07
AUDIO_TEMP_DIR=./data/audio-temp
AUDIO_TEMP_TTL_HOURS=24
# 8단계: 라이선스 참조 음원(영구, TTL 없음) + 사전 계산된 임베딩을 두는 디렉터리.
AUDIO_REFERENCE_DIR=./data/audio-reference
# TTL 스윕(AudioSessionCleanupService) 주기 — 기본 1시간마다 만료 세션 정리.
AUDIO_CLEANUP_INTERVAL_MS=3600000
# 10 MB (docs 03의 "최대 10 MB" 그대로).
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_DURATION_SECONDS=15
AUDIO_ANALYSIS_TIMEOUT_MS=15000

# 참조 음원 소싱 도구 전용(research/audio-reference-pool/fetch_xeno_canto.ts, 런타임 서버는
# 안 씀). xeno-canto.org 계정 가입 후 Account 페이지에서 발급 — 자동 발급 불가, 사람이 직접
# 해야 함(research/audio-reference-pool/README.md 참고).
XENO_CANTO_API_KEY=

# --- 종 마스터 데이터 소스 ------------------------------------------------------
# TODO(제공 필요): 국가생물종지식정보시스템 등 공공 데이터 API 키/엔드포인트
#                  (라이선스 확인 필요 — 명세서 §15)
SPECIES_MASTER_API_KEY=
SPECIES_MASTER_ENDPOINT=

# --- 음성 나레이션(TTS) --------------------------------------------------------
# TODO(제공 필요): 성우 녹음을 쓰면 불필요. TTS 사용 시 자격 증명.
TTS_PROVIDER=
TTS_API_KEY=

# --- 푸시 알림 -----------------------------------------------------------------
# TODO(제공 필요): FCM/APNs 자격 증명
PUSH_PROVIDER=
PUSH_API_KEY=

# --- 인증 [필수-프로덕션] --------------------------------------------------------
# JWT 서명 키(C단계). 비어있으면 개발 환경(NODE_ENV!=production)에서는 서버가 매번
# 임의 시크릿을 생성해 경고를 찍고 계속 동작한다(재시작마다 기존 토큰 전부 무효화).
# 프로덕션에서는 assertProductionConfig()가 이 값 없이는 부팅 자체를 막는다.
AUTH_JWT_SECRET=

# --- HTTP 서버(C단계) -----------------------------------------------------------
# app/src/config/env.ts의 API_BASE_URL('http://localhost:8080')과 기본값이 일치한다.
HTTP_PORT=8080
# 바인딩 주소. 비워두면(기본) 127.0.0.1 — 이 컴퓨터에서만 접근 가능(안전).
# 같은 Wi-Fi의 휴대폰(Expo Go) 등 다른 기기에서 접근하려는 테스트 때만 0.0.0.0으로 채운다.
# 주의: 이렇게 하면 같은 네트워크의 다른 모든 기기도 이 서버에 접근할 수 있게 된다 —
# 테스트가 끝나면 다시 비워두거나 주석 처리할 것.
# HTTP_HOST=0.0.0.0

# --- 동정 비용/한도 정책 --------------------------------------------------------
# 무료 사용자의 1일 동정 호출 한도 (명세서 §15에서 수치 확정 예정). 0=무제한.
FREE_DAILY_IDENTIFY_LIMIT=20

# --- 지도(F11) -------------------------------------------------------------------
# 카카오맵 JS SDK 키. developers.kakao.com에서 애플리케이션 등록 후 "앱 키" 탭의
# JavaScript 키를 그대로 채운다. 앱 설정 > 플랫폼 > Web에는 WebView가 기준 origin으로
# 쓰는 https://localhost:8080을 등록해야 한다. 실제 /map.html은 LAN 백엔드에서 받아오지만,
# 카카오 SDK와 타일은 이 HTTPS origin을 기준으로 로드한다.
# 비워두면(기본) /map.html이 지도를 못 띄운다.
KAKAO_MAP_JS_KEY=

# --- 도감 박사(F22, CPU 임베딩 워커) -------------------------------------------
# GPU 동정 모델과 별개다. 같은 서버 또는 로컬 CPU에서 워커를 127.0.0.1로 실행한다.
# 비워두면 개발/테스트에서만 문자 n-gram 기반 로컬 임베딩으로 UI 흐름을 확인할 수 있고,
# 프로덕션에서는 도감 박사 API만 503을 반환한다(기존 동정·도감 기능은 계속 정상 동작).
# PROFESSOR_EMBEDDING_ENDPOINT=http://127.0.0.1:8941
PROFESSOR_EMBEDDING_TIMEOUT_MS=1500
PROFESSOR_VECTOR_INDEX_FILE=./data/professor-knowledge-vectors.json
PROFESSOR_CONFIDENCE_HIGH=0.70
PROFESSOR_CONFIDENCE_MEDIUM=0.50
PROFESSOR_CONFIDENCE_LOW=0.35

# =============================================================================
# 『씨앗(SEED)』 환경 변수 예시
# -----------------------------------------------------------------------------
# 사용법: 이 파일을 `.env` 로 복사한 뒤, 아래 공란(빈 값)을 실제 값으로 채운다.
# 값이 비어 있으면 서비스는 안전한 개발용 기본값(Mock 동정, in-memory 저장소)으로
# 동작한다. 프로덕션 전에 반드시 채워야 하는 항목은 [필수-프로덕션] 으로 표시.
# =============================================================================

# --- 실행 환경 -----------------------------------------------------------------
NODE_ENV=development

# --- 데이터베이스 [필수-프로덕션] ------------------------------------------------
# TODO(제공 필요): 관리형 DB 연결 문자열 (예: postgres://user:pass@host:5432/seed)
DATABASE_URL=

# --- 미디어 저장소 [필수-프로덕션] ------------------------------------------------
# TODO(제공 필요): 사진 업로드용 오브젝트 스토리지 (S3 등) 자격 증명/버킷
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=

# --- 동정(Identification) 외부 API ---------------------------------------------
# 어느 것도 채우지 않으면 MockProvider 로 동작한다(개발/데모용).
# Plant.id (kindwise) — 식물 + insect.id(곤충)
# TODO(제공 필요): 유료 API 키
PLANT_ID_API_KEY=
PLANT_ID_ENDPOINT=https://plant.id/api/v3
INSECT_ID_ENDPOINT=https://insect.kindwise.com/api/v1

# Pl@ntNet — 식물 (대체/보조 프로바이더)
# TODO(제공 필요): 유료 API 키
PLANTNET_API_KEY=
PLANTNET_ENDPOINT=https://my-api.plantnet.org/v2

# BioCLIP 하이브리드 추론 서버(B단계) — 자체 GPU 서버, systemd 상시 구동.
# 이 서버는 127.0.0.1에만 바인딩되어 있고 외부 방화벽을 열지 않았으므로, 로컬 개발 중에는
# SSH 로컬 포트포워딩으로 터널을 먼저 열어야 한다(터미널에서, 개발자 본인 키로):
#   ssh -L 8931:127.0.0.1:8931 <user>@<gpu-server-host>
# apiKey가 없는 프로바이더라 endpoint 자체가 온/오프 스위치다 -- 비워두면(기본) 꺼진
# 상태로 동작한다(Mock으로 폴백). 터널을 띄운 뒤에만 아래 주석을 풀고 값을 채운다.
# BIOCLIP_ENDPOINT=http://127.0.0.1:8931
BIOCLIP_TIMEOUT_MS=15000

# --- 종 마스터 데이터 소스 ------------------------------------------------------
# TODO(제공 필요): 국가생물종지식정보시스템 등 공공 데이터 API 키/엔드포인트
#                  (라이선스 확인 필요 — 명세서 §15)
SPECIES_MASTER_API_KEY=
SPECIES_MASTER_ENDPOINT=

# --- 음성 나레이션(TTS) --------------------------------------------------------
# TODO(제공 필요): 성우 녹음을 쓰면 불필요. TTS 사용 시 자격 증명.
TTS_PROVIDER=
TTS_API_KEY=

# --- 푸시 알림 -----------------------------------------------------------------
# TODO(제공 필요): FCM/APNs 자격 증명
PUSH_PROVIDER=
PUSH_API_KEY=

# --- 인증 [필수-프로덕션] --------------------------------------------------------
# TODO(제공 필요): 보호자 계정 인증 서명 키 등
AUTH_JWT_SECRET=

# --- 동정 비용/한도 정책 --------------------------------------------------------
# 무료 사용자의 1일 동정 호출 한도 (명세서 §15에서 수치 확정 예정). 0=무제한.
FREE_DAILY_IDENTIFY_LIMIT=20
